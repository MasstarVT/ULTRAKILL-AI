# Local game path (machine-specific)
mod/GamePaths.props

# .NET build output
bin/
obj/
*.user
.vs/

# Never commit game assemblies or decompiled game code
*.dll
*.pdb
decompiled/
.tools/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Training output (checkpoints under python/models/ are committed on purpose: they are the
# transferable state of a run; runs/ holds TensorBoard and dashboard logs and stays local)
runs/
# v1 (abandoned run): only latest.zip and pitch_reset_2447005.zip are kept in git
python/models/cybergrind_ppo/ckpt_*.zip
# v2: the numbered checkpoints are ~12 MB each (107 of them, 1.2 GB, from the 2026-09-16 run alone).
# best.zip + best.json (written by scripts/keep_best.py) and latest.zip are the transferable state.
# The 23 numbered ones committed before this rule stay tracked; gitignore does not untrack them.
python/models/cybergrind_ppo_v2/ckpt_*.zip
python/models/cybergrind_ppo_v2/best_*kpm_*.zip
python/models/cybergrind_ppo_v2/*.bad
# Campaign: numbered checkpoints stay local, as for v2. transfer_init.zip (the widened Cyber Grind weights),
# best.zip + best.json, latest.zip, env_config.yaml and the explore_*.npz exploration archives are committed.
python/models/campaign_ppo/ckpt_*.zip
python/models/campaign_ppo_ground/ckpt_*.zip
# The route-gates run. look_init.zip (the look-mode-widened weights, the only path an older campaign
# checkpoint can take into this action space) is committed, as are its explore_*.npz archives.
python/models/campaign_gates/ckpt_*.zip
# The per-level specialist stages (scripts/campaign_driver.py). Each stage is its own run directory, so the
# same rule applies to each of them: the numbered checkpoints stay local and best.zip + best.json, latest.zip,
# env_config.yaml and the explore_*.npz archives are committed. `models/specialists/` -- the ONE promoted
# policy per level plus its JSON sidecar -- is tracked on purpose: it is the deliverable, and it is what
# scripts/full_run.py chains.
python/models/spec_*/ckpt_*.zip
# Throwaway in-game smoke runs
python/models/campaign_smoke*/

# Claude Code local session state
.claude/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
